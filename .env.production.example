# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# Spring Profile
SPRING_PROFILE=prod

# Database Configuration
DATABASE_URL=jdbc:mysql://localhost:3306/bakery_db?createDatabaseIfNotExist=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# JWT Configuration (Generate a secure random string)
# Use: openssl rand -base64 64
JWT_SECRET=your_very_long_and_secure_random_secret_at_least_256_bits
JWT_EXPIRATION=86400000

# Email Configuration (Gmail example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Admin Email
ADMIN_EMAIL=admin@yourdomain.com

# Razorpay Configuration (LIVE keys after KYC)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL Configuration (if using)
SSL_ENABLED=false
SSL_KEYSTORE_PATH=/path/to/keystore.p12
SSL_KEYSTORE_PASSWORD=your_keystore_password

# Sentry Error Tracking (Optional)
SENTRY_DSN=your_sentry_dsn_here
