# ========================================
# BACKEND ENVIRONMENT VARIABLES (Example)
# ========================================
# For production deployment, set these in your hosting environment

# Database
DATABASE_URL=jdbc:mysql://your-db-host:3306/bakery_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_db_password

# JWT
JWT_SECRET=your_very_long_and_secure_random_secret_at_least_256_bits
JWT_EXPIRATION=86400000

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Admin
ADMIN_EMAIL=admin@yourdomain.com

# Razorpay (LIVE keys after KYC)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Frontend
FRONTEND_URL=https://yourdomain.com

# CORS
CORS_ORIGINS=https://yourdomain.com

# SSL
SSL_ENABLED=true
SSL_KEYSTORE_PATH=/path/to/keystore.p12
SSL_KEYSTORE_PASSWORD=your_keystore_password
